# Application
NODE_ENV=development
PORT=3001
AI_GATEWAY_PORT=3002

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=medellinshow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# CORS (comma-separated origins for web/mobile clients; Vite dev uses localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment Providers
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# MERCADOPAGO_ACCESS_TOKEN=

# AI Gateway URL (internal)
AI_GATEWAY_URL=http://localhost:3002

# Messaging Providers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

# Email Provider
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@themedellinshow.com
SENDGRID_FROM_NAME=The Medellín Show

# Payouts to hosts (business rules: docs/business-rules/payouts-and-referrals.md)
# Hours a completed booking is held before the host payout becomes available (72h dispute window)
PAYOUT_RELEASE_HOURS=72
# Minimum available balance to include a host in the weekly payout batch (COP)
PAYOUT_MIN_COP=100000
# Default commission rate applied over the service value (before taxes/holds)
PAYOUT_DEFAULT_COMMISSION=0.2
# How often the payout sweep runs (release eligible + weekly batch) in minutes
PAYOUT_SWEEP_INTERVAL_MINUTES=30
# Minimum time between weekly payout batches in minutes (default: 7 days)
PAYOUT_BATCH_PERIOD_MINUTES=10080

# Referral wallet (business rules: docs/business-rules/payouts-and-referrals.md)
# Reward as % of the referred user's first purchase, capped at REWARD_CAP
REFERRAL_REWARD_RATE=0.1
REFERRAL_REWARD_CAP=100000
# Wallet credit validity once confirmed (months)
REFERRAL_CREDIT_TTL_MONTHS=12
# How often the wallet sweep runs (confirm eligible credits + expire) in minutes
WALLET_SWEEP_INTERVAL_MINUTES=30
